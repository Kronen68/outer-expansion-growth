msgstr "Turn back."

#: src-en/data/events_sector_oe_acid.xml:3868
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"DISTRESS_OE_ACID_INVESTIGATE\"]/choice/event/choice[4]/event/text"
msgstr ""
