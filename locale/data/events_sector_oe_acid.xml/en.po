#: src-en/data/events_sector_oe_acid.xml:3959
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_BILL_MEET\"]/choice[3]/event/choice[1]/text"
