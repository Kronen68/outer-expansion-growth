"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_PRAETOR_DIPLOMATIC\"]/choice[1]/event/choice/event/choice[1]/event/choice/event/choice[1]/text"
