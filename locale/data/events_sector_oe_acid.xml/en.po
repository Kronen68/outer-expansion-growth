"rejoin it."

#: src-en/data/events_sector_oe_acid.xml:3998
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_BILL_JOIN1\"]/choice[@req=\"unique_oe_bill\""
" and @lvl=\"0\"]/event/choice/text"
msgstr "What's your name?"

#: src-en/data/events_sector_oe_acid.xml:4000
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_BILL_JOIN1\"]/choice[@req=\"unique_oe_bill\""
" and @lvl=\"0\"]/event/choice/event/text"
msgstr "\"Name? Name. Call us: Bill. That's... that's probably all we are now.\""

#: src-en/data/events_sector_oe_acid.xml:4002
