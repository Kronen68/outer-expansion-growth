"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_PRAETOR_DIPLOMATIC\"]/choice[1]/event/choice/event/choice[1]/text"
msgstr "What is the mission? You don't seem to be doing anything."

#: src-en/data/events_sector_oe_acid.xml:1511
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_ACIDIC_OE_ACID_PRAETOR_DIPLOMATIC\"]/choice[1]/event/choice/event/choice[1]/event/text"
msgstr ""
"Your question pisses him off even more, and he almost starts screaming - "
"before a different orchid pushes him off screen. \"Tar'Ek, calm down. Let me"
