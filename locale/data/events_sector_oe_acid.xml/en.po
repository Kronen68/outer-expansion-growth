#: src-en/data/events_sector_oe_acid.xml:363
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_MYSTERIOUS_TECH\"]/choice[2]/event/text"
msgstr "The Slug cuts comms and slinks away deeper into the nebula."

#: src-en/data/events_sector_oe_acid.xml:365
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_MYSTERIOUS_TECH\"]/choice[2]/event/choice[1]/text"
