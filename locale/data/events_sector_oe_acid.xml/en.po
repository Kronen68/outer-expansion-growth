#: src-en/data/events_sector_oe_acid.xml:353
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_MYSTERIOUS_TECH\"]/text"
msgstr ""
"You're hailed by a Hektar ship hiding deep in this nebula. \"Hello captain, "
"that issss one fine vesssel. However, we have sssome tech that we asssure "
"you will make your ssship even better!\""

#: src-en/data/events_sector_oe_acid.xml:357
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_MYSTERIOUS_TECH\"]/choice[1]/text"
msgstr "Purchase their tech for 15 scrap."

#: src-en/data/events_sector_oe_acid.xml:361
msgid ""
"data/events_sector_oe_acid.xml$//event[@name=\"NEBULA_OE_ACID_MYSTERIOUS_TECH\"]/choice[2]/text"
