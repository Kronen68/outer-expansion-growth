msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"REINFORCEMENTS_OE_ACID\"]/beaconType/unvisitedTooltip"
msgstr "An unvisited location."

#: src-en/data/events_special_oe_acid.xml:185
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"REINFORCEMENTS_OE_ACID\"]/beaconType/visitedTooltip"
