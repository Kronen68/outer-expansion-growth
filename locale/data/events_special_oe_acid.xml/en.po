#: src-en/data/events_special_oe_acid.xml:188
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"REINFORCEMENTS_OE_ACID\"]/text"
msgstr ""
"The Acidic Growth has not taken your less than friendly entry to the sector "
