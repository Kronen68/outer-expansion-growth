" and @lvl=\"0\"]/text"
msgstr "Install the Life Bloom system."

#: src-en/data/events_special_oe_acid.xml:1479
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"NEBULA_STORM_OE_ACID_AUGITEM_WIN\"]/choice[@req=\"oe_growth\""
" and @lvl=\"0\"]/event/text"
msgstr ""
"You're able to install the organic system in the space previously occupied "
