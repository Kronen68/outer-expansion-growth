"data/events_special_oe_acid.xml$//ship[@name=\"SHIP_OE_ACID_AUGITEM\"]/destroyed/text"
msgstr "You've defeated the Acidic Growth, leaving the shipyard unprotected."

#: src-en/data/events_special_oe_acid.xml:1469
msgid ""
"data/events_special_oe_acid.xml$//ship[@name=\"SHIP_OE_ACID_AUGITEM\"]/destroyed/choice/text"
msgstr "Continue..."

#: src-en/data/events_special_oe_acid.xml:1471
