#: src-en/data/events_special_oe_acid.xml:1484
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"NEBULA_STORM_OE_ACID_AUGITEM_WIN\"]/choice[3]/text"
msgstr "Scrap it for parts."

#: src-en/data/events_special_oe_acid.xml:1486
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"NEBULA_STORM_OE_ACID_AUGITEM_WIN\"]/choice[3]/event/text"
msgstr "You dismantle it for the few salvagable components contained within."

#: src-en/data/events_special_oe_acid.xml:1496
msgid ""
"data/events_special_oe_acid.xml$//ship[@name=\"SHIP_OE_ACID_AUGITEM\"]/deadCrew/text"
msgstr "You've defeated the Acidic Growth, leaving the shipyard unprotected."

#: src-en/data/events_special_oe_acid.xml:1499
msgid ""
"data/events_special_oe_acid.xml$//ship[@name=\"SHIP_OE_ACID_AUGITEM\"]/deadCrew/choice/text"
