msgstr "An unvisited location."

#: src-en/data/events_special_oe_acid.xml:201
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"NEBULA_LIGHT_REINFORCEMENTS_OE_ACID\"]/beaconType/visitedTooltip"
msgstr "Explored location. Nothing left of interest."

