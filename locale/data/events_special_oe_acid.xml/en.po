"to the ship, and move on to scrap their hull."

#: src-en/data/events_special_oe_acid.xml:424
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"GUARD_OE_ACIDHOME_DEADCREW\"]/choice/text"
msgstr "Continue..."

#: src-en/data/events_special_oe_acid.xml:434
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"GUARD_OE_ACIDHOME_PRAETOR_DESTROY\"]/text"
msgstr "You have defeated the Praetor vessel. You can now salvage both ships."

#: src-en/data/events_special_oe_acid.xml:437
msgid ""
"data/events_special_oe_acid.xml$//event[@name=\"GUARD_OE_ACIDHOME_PRAETOR_DESTROY\"]/choice/text"
