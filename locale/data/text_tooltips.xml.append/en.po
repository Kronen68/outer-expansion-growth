#: src-en/data/text_tooltips.xml.append:2
msgid "data/text_tooltips.xml.append$//text[@name=\"tip_oe_acid\"]"
msgstr ""
"Acid weapons release Acidic Gas into hit rooms. Gas causes a hull breach "
"every 5 seconds and damages connected doors, causing them to break open "
"temporarily. Lasts for 5 seconds."

#: src-en/data/text_tooltips.xml.append:3
msgid "data/text_tooltips.xml.append$//text[@name=\"tooltip_oe_acidic_nebula\"]"
msgstr ""
"You're inside an Acidic nebula. Your sensors will not function and your "
"rooms will be slowly breached at random by the Acidic clouds."
